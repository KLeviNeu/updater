{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Draw Wizard",
  "version": "1.0.0",
  "identifier": "com.komar.updater",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Draw Wizard",
        "width": 800,
        "height": 600,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExMDRGODFFRDJENzk5MjgKUldRb21kZlNIdmdFb1JxWmZ2QUVMcVZ1Zi9iclV2cFVzT0dUajUyS2NKaDZicnF3Z1k3SklIYVgK",
      "endpoints": [
        "https://raw.githubusercontent.com/KLeviNeu/Draw-Wizard/refs/heads/main/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}